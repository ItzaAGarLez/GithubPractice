<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <title>Práctica Formularios y Tabla</title>
</head>
<body>
  
  <h1>Proyecto Web <sup>&copy;</sup></h1>

  
  <form>
   
    <fieldset>
      <legend>"Datos Personales"</legend>

      <label for="nombre">Primer nombre:</label>
      <input type="text" id="nombre" name="nombre" placeholder="Tu nombre"><br><br>

      <label for="apellido">Primer apellido:</label>
      <input type="text" id="apellido" name="apellido" placeholder="Tu apellido"><br><br>

      <label for="correo">Correo:</label>
      <input type="email" id="correo" name="correo" placeholder="ejemplo@correo.com"><br><br>

      <label for="clave">Contraseña:</label>
      <input type="password" id="clave" name="clave" placeholder="********"><br><br>

      <label for="edad">Edad:</label>
      <input type="number" id="edad" name="edad" placeholder="18"><br><br>
    </fieldset>

    
    <fieldset>
      <legend>"Preferencias"</legend>

     
      <label><input type="checkbox" name="suscripcion"> Suscribirse al boletín</label><br><br>

     
      <p>Notificarme de:</p>
      <label for="notif-ofertas"</label>
      <label>type="checkbox" id="notif-ofretas" name="notificaciones" veleu="ofertas"</label>
      <label>for="notif-ofertas">Novedades</label><br>
      <br>

    
      <label for="volumen">Califica la aplixacion:</label>
      <input type="range" id="volumen" name="volumen" min="0" max="100"><br><br>

      
      <input type="submit" value="Enviar formulario">
      <button type="button">Acción JS</button>
    </fieldset>
  </form>

 
  <form action="https://www.youtube.com/results" method="get" target="_blank">
    <fieldset>
      <legend>"Búsqueda en YouTube"</legend>
      <label for="busqueda">Buscar:</label>
      <input type="text" id="busqueda" name="search_query" placeholder="Videos en YouTube">
      <input type="submit" value="Buscar">
    </fieldset>
  </form>

  <!-- TABLA -->
  <table border="1">
    <thead>
      <tr>
        <th colspan="3">Tabla de Ejemplo</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td rowspan="2">Fila 1-2, Columna 1</td>
        <td>Fila 1, Columna 2</td>
        <td>Fila 1, Columna 3</td>
      </tr>
      <tr>
        <td colspan="2">Fila 2, Columnas 2-3</td>
      </tr>
      <tr>
        <td>Fila 3, Columna 1</td>
        <td>Fila 3, Columna 2</td>
        <td>Fila 3, Columna 3</td>
      </tr>
    </tbody>
  </table>
</body>
</html>
